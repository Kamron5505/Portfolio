# Скопируйте этот файл в .env.local. Обязательных переменных у проекта нет —
# сайт собирается и работает без .env.local вообще.

# ── Домен сайта (необязательно) ──────────────────────────────────────────────
# От него строятся canonical, hreflang, og:url, sitemap.xml, robots.txt и
# JSON-LD. Без слэша в конце.
#
# Если переменная не задана, берётся значение по умолчанию из src/lib/data.ts
# (CANONICAL_SITE_URL). Адреса preview-деплоёв (*.vercel.app и т.п.) намеренно
# игнорируются: канонический домен всё равно останется https://kamronfazilov.uz.
NEXT_PUBLIC_SITE_URL=https://kamronfazilov.uz

# ── Gemini: разбор ответов квиза (необязательно) ─────────────────────────────
# Ключ из Google AI Studio. Читается только на сервере в /api/quiz — префикса
# NEXT_PUBLIC_ у него быть не должно, иначе он уедет в браузер к каждому
# посетителю. В git этот ключ не коммитится никогда: репозиторий публичный.
#
# Без ключа секция квиза работает как обычный опросник: вопросы задаются,
# ответы собираются, но вместо разбора показывается переход в Telegram.
GEMINI_API_KEY=

# Необязательно: сменить модель, не трогая код. По умолчанию gemini-3.5-flash-lite.
GEMINI_MODEL=

# ── Telegram: заявки из квиза (необязательно) ────────────────────────────────
# Когда обе переменные заданы, заполненный опросник падает вам в Telegram —
# иначе лид остаётся только на экране у посетителя.
#   1. Создайте бота у @BotFather, скопируйте токен сюда.
#   2. Напишите своему боту любое сообщение.
#   3. Откройте https://api.telegram.org/bot<ТОКЕН>/getUpdates и возьмите
#      оттуда result[0].message.chat.id — это TELEGRAM_CHAT_ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
