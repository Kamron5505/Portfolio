# Скопируйте этот файл в .env.local и заполните значения.
# .env.local в git не попадает — это ваши секреты.

# ── База данных (обязательно для админки) ────────────────────────────────────
# Neon Postgres. Проще всего создать прямо из Vercel:
#   Vercel → проект → Storage → Create Database → Neon.
# Строка вида: postgresql://user:password@ep-xxx.neon.tech/dbname?sslmode=require
DATABASE_URL=

# ── Сессия админки (обязательно) ─────────────────────────────────────────────
# Минимум 32 символа. Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ADMIN_SESSION_SECRET=

# ── Учётка администратора ────────────────────────────────────────────────────
# Используются только скриптом `npm run db:setup`: он кладёт в базу хеш пароля.
# Сам пароль нигде не хранится. Минимум 10 символов.
ADMIN_USERNAME=kamron
ADMIN_PASSWORD=

# ── Хранилище файлов (нужно на Vercel) ───────────────────────────────────────
# Vercel → проект → Storage → Create → Blob. Скопируйте токен сюда.
# Без него загрузки идут в локальную папку public/uploads: на своей машине это
# удобно, но на Vercel файлы пропадут при следующем деплое — там диск только
# для чтения.
BLOB_READ_WRITE_TOKEN=
